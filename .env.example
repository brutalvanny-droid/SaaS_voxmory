# ============================================================
#  VOXMORY — variables d'environnement
#  Copiez ce fichier vers .env et complétez-le.
#  En production, saisissez ces valeurs dans Vercel :
#  Project → Settings → Environment Variables
# ============================================================

# ------------------------------------------------------------
#  Base de données — Neon (Postgres serverless)
# ------------------------------------------------------------
# Chaîne de connexion fournie par Neon, avec ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/voxmory?sslmode=require"

# ------------------------------------------------------------
#  Sécurité — sessions d'administration
# ------------------------------------------------------------
# Clé de signature des jetons JWT. 32 caractères minimum.
# Générez-la avec :  openssl rand -base64 48
ADMIN_JWT_SECRET=""

# Identifiants du premier compte administrateur, créés par `npm run db:seed`.
# Le mot de passe est haché en bcrypt : il ne sera jamais stocké en clair.
ADMIN_EMAIL="admin@voxmory.com"
ADMIN_PASSWORD=""

# ------------------------------------------------------------
#  Paiements — SasPay
# ------------------------------------------------------------
# Clé secrète marchand (sk_test_… puis sk_live_… en production).
# Ne jamais exposer côté navigateur.
SASPAY_API_KEY=""
# Secret de signature des webhooks, affiché UNE SEULE FOIS lors de la
# création du webhook dans le tableau de bord SasPay.
SASPAY_WEBHOOK_SECRET=""
# Devise envoyée à SasPay lors de l'encaissement.
# Pour la RDC, la devise par défaut de la plateforme est le CDF.
# Si vos tarifs restent affichés en USD, conservez USD et vérifiez auprès
# de SasPay que la combinaison pays/devise est acceptée sur votre compte.
SASPAY_DEFAULT_CURRENCY="USD"
# Code pays ISO à 2 lettres utilisé pour l'encaissement.
SASPAY_DEFAULT_COUNTRY="CD"

# ------------------------------------------------------------
#  Notifications WhatsApp — passerelle OpenWA auto-hébergée
# ------------------------------------------------------------
# OpenWA tourne sur votre propre serveur ; on l'appelle en HTTP
# depuis Vercel, aucune session persistante n'est nécessaire ici.
OPENWA_URL=""
OPENWA_API_KEY=""
OPENWA_SESSION_ID=""
# Numéro qui reçoit les notifications de nouvelle commande.
ADMIN_WHATSAPP_NUMBER=""

# ------------------------------------------------------------
#  Stockage des fichiers — Vercel Blob
# ------------------------------------------------------------
# Créé automatiquement par Vercel : Storage → Blob → Create Store
# puis Connect Project. Laissez vide en développement local :
# les fichiers seront alors déposés dans public/uploads.
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------
#  Assistant IA du studio — Google Gemini
# ------------------------------------------------------------
# Sans cette clé, l'assistant affiche un message d'indisponibilité
# explicite au lieu de produire un contenu simulé.
GEMINI_API_KEY=""

# ------------------------------------------------------------
#  Application
# ------------------------------------------------------------
# URL publique, utilisée pour les liens de retour de paiement
# et les liens de suivi envoyés par WhatsApp.
APP_URL="http://localhost:5173"

# Google Analytics (facultatif)
VITE_GA_MEASUREMENT_ID=""
